# yt-summarizer — configuración
#
# Copiá este archivo a `.env` y completá los valores.
# `.env` NO se commitea (está en .gitignore); `.env.example` es la plantilla.

# Proveedor LLM por defecto: openai | gemini
# (si no se define, el default es: openai)
LLM_PROVIDER=openai

# API key de OpenAI (requerida si LLM_PROVIDER=openai)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# API key de Google Gemini (requerida si LLM_PROVIDER=gemini)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
